# ------------------------------------------------------------------
# Copy this file to .env.local and fill in every value.
# All values come from the Firebase console (see README.md).
# ------------------------------------------------------------------

# 1. Firebase WEB app config — Firebase console > Project settings > General >
#    "Your apps" > Web app (SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 2. Firebase Admin SDK (server side) — Firebase console > Project settings >
#    Service accounts > "Generate new private key". Open the downloaded JSON
#    and copy these three fields. Paste the private_key EXACTLY as it appears
#    in the JSON (with the \n sequences) — the app converts them to newlines.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# 3. Public URL of this app. QR codes encode "{NEXT_PUBLIC_APP_URL}/verify/{code}".
#    For local development use http://localhost:3000.
#    On Vercel set this to your production URL, e.g. https://my-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
